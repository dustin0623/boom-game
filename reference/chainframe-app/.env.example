# ============================================================
# Chainframe — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# MongoDB connection string. Required for all application persistence.
# Standalone self-hosted MongoDB is supported; no transaction or replica-set requirement.
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/cryptocore?retryWrites=true&w=majority
# Local test instance: mongodb://localhost:2707/cryptocore
# Keep the installed service's actual port (commonly 27017); do not change it to match this example.
# Direct connection setup: docs/GAME_ARCHITECTURE.md, Direct MongoDB operations.
MONGODB_URI=

# MongoDB database name (default: cryptocore, intentionally retained after the Chainframe rename).
MONGODB_DB=cryptocore


# ------------------------------------------------------------
# AUTH (required whenever authenticating)
# ------------------------------------------------------------

# JWT and login-challenge secret: at least 32 UTF-8 bytes. No development fallback.
# Generate with: openssl rand -base64 32
JWT_SECRET=


# ------------------------------------------------------------
# BLOCKCHAIN — Hive mainnet (required for deposits / withdrawals)
# -----------------------------------------------------------------------------
# Hive account receiving deposits and funding withdrawals.
HIVE_TREASURY_ACCOUNT=

# Server-only active key for the treasury account. Never expose or commit it.
HIVE_TREASURY_ACTIVE_KEY=

# Public browser-safe values used by the Keychain transfer UI.
NEXT_PUBLIC_HIVE_TREASURY_ACCOUNT=

# Marketplace HIVE escrow: receives purchases and funds seller payouts/refunds.
HIVE_MARKET_ACCOUNT=
# Server-only market active key. Never expose or commit it.
HIVE_MARKET_ACTIVE_KEY=
# Public recipient must match the server market account; rebuild after changing it.
NEXT_PUBLIC_HIVE_MARKET_ACCOUNT=

# Stream settings (non-secret). Fixed game ID/version live in the shared Hive client.
HIVE_GAME_STREAM_ENABLED=true
HIVE_GAME_STREAM_POLL_MS=5000
# Fresh worker processes start at the latest irreversible block.
# Recovery within that process resumes its in-memory block position.
# Authoritative processing uses ordered direct writes and durable pending-job guards.
# New submissions require a ready worker; health readiness uses recent block-check timestamps, not saved blocks.

# Integration tests use MONGODB_URI with generated isolated database names.
# Tests never clean MONGODB_DB; the connection needs permission for test databases.

# Review outstanding financial jobs before deployment.
# Stop it, deploy application + worker together, rebuild public account config and reload clients.
# Unsupported financial evidence is parked; no automatic conversion or rebroadcast.
